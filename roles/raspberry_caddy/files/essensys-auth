#!/bin/bash
#
# essensys-auth - Outil d'administration de l'authentification Essensys
# Gère les utilisateurs et les modes d'authentification LAN/WAN
#

set -e

# Configuration paths
AUTH_DIR="/etc/essensys/auth"
CONFIG_FILE="$AUTH_DIR/config.env"
HTPASSWD_FILE="$AUTH_DIR/users.htpasswd"
CADDY_CONFIG="/etc/caddy/Caddyfile"
CADDY_TEMPLATES="/opt/essensys-caddy"

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Vérifier les permissions root
check_root() {
    if [ "$EUID" -ne 0 ]; then
        log_error "Ce script doit être exécuté en tant que root (utilisez sudo)"
        exit 1
    fi
}

# Initialiser la configuration si nécessaire
init_config() {
    if [ ! -d "$AUTH_DIR" ]; then
        mkdir -p "$AUTH_DIR"
        chmod 700 "$AUTH_DIR"
    fi

    if [ ! -f "$CONFIG_FILE" ]; then
        cat > "$CONFIG_FILE" <<EOF
# Configuration authentification Essensys
# Généré automatiquement - ne pas modifier manuellement

ESSENSYS_AUTH_ENABLED=1
ESSENSYS_LAN_NOAUTH=0
ESSENSYS_AUTH_REALM="Essensys"
EOF
        chmod 600 "$CONFIG_FILE"
        log_info "Configuration initialisée dans $CONFIG_FILE"
    fi

    if [ ! -f "$HTPASSWD_FILE" ]; then
        touch "$HTPASSWD_FILE"
        chmod 600 "$HTPASSWD_FILE"
    fi
}

# Charger la configuration
load_config() {
    if [ -f "$CONFIG_FILE" ]; then
        # shellcheck source=/dev/null
        source "$CONFIG_FILE"
    else
        ESSENSYS_AUTH_ENABLED=1
        ESSENSYS_LAN_NOAUTH=0
        ESSENSYS_AUTH_REALM="Essensys"
    fi
}

# Sauvegarder la configuration
save_config() {
    cat > "$CONFIG_FILE" <<EOF
# Configuration authentification Essensys
# Généré automatiquement - ne pas modifier manuellement

ESSENSYS_AUTH_ENABLED=${ESSENSYS_AUTH_ENABLED:-1}
ESSENSYS_LAN_NOAUTH=${ESSENSYS_LAN_NOAUTH:-0}
ESSENSYS_AUTH_REALM="${ESSENSYS_AUTH_REALM:-Essensys}"
EOF
    chmod 600 "$CONFIG_FILE"
}

# Générer la configuration Caddy
generate_caddy_config() {
    load_config
    
    local template_file
    if [ "$ESSENSYS_AUTH_ENABLED" = "0" ]; then
        template_file="$CADDY_TEMPLATES/Caddyfile.noauth"
    elif [ "$ESSENSYS_LAN_NOAUTH" = "1" ]; then
        template_file="$CADDY_TEMPLATES/Caddyfile.lan-noauth"
    else
        template_file="$CADDY_TEMPLATES/Caddyfile.auth"
    fi

    if [ ! -f "$template_file" ]; then
        log_error "Template non trouvé: $template_file"
        exit 1
    fi

    # Remplacer les variables dans le template
    sed -e "s|{{AUTH_REALM}}|${ESSENSYS_AUTH_REALM}|g" \
        -e "s|{{HTPASSWD_FILE}}|${HTPASSWD_FILE}|g" \
        "$template_file" > "$CADDY_CONFIG"

    log_info "Configuration Caddy générée"
}

# Recharger Caddy
reload_caddy() {
    if systemctl is-active --quiet caddy; then
        systemctl reload caddy
        log_info "Caddy rechargé"
    else
        log_warn "Caddy n'est pas en cours d'exécution"
    fi
}

# Appliquer les changements (générer config + reload)
apply_changes() {
    generate_caddy_config
    reload_caddy
}

# Ajouter un utilisateur
cmd_add_user() {
    local username="$1"
    
    if [ -z "$username" ]; then
        log_error "Usage: essensys-auth add-user <username>"
        exit 1
    fi

    # Vérifier si l'utilisateur existe déjà
    if grep -q "^${username}:" "$HTPASSWD_FILE" 2>/dev/null; then
        log_error "L'utilisateur '$username' existe déjà"
        exit 1
    fi

    # Demander le mot de passe
    echo -n "Mot de passe pour $username: "
    read -rs password
    echo
    echo -n "Confirmer le mot de passe: "
    read -rs password_confirm
    echo

    if [ "$password" != "$password_confirm" ]; then
        log_error "Les mots de passe ne correspondent pas"
        exit 1
    fi

    if [ -z "$password" ]; then
        log_error "Le mot de passe ne peut pas être vide"
        exit 1
    fi

    # Générer le hash bcrypt avec caddy
    local hash
    hash=$(caddy hash-password --plaintext "$password" 2>/dev/null)
    
    if [ -z "$hash" ]; then
        log_error "Erreur lors de la génération du hash"
        exit 1
    fi

    # Ajouter au fichier htpasswd
    echo "${username}:${hash}" >> "$HTPASSWD_FILE"
    chmod 600 "$HTPASSWD_FILE"

    log_info "Utilisateur '$username' ajouté"
    apply_changes
}

# Supprimer un utilisateur
cmd_del_user() {
    local username="$1"
    
    if [ -z "$username" ]; then
        log_error "Usage: essensys-auth del-user <username>"
        exit 1
    fi

    if ! grep -q "^${username}:" "$HTPASSWD_FILE" 2>/dev/null; then
        log_error "L'utilisateur '$username' n'existe pas"
        exit 1
    fi

    # Supprimer l'utilisateur
    sed -i "/^${username}:/d" "$HTPASSWD_FILE"

    log_info "Utilisateur '$username' supprimé"
    apply_changes
}

# Changer le mot de passe
cmd_passwd() {
    local username="$1"
    
    if [ -z "$username" ]; then
        log_error "Usage: essensys-auth passwd <username>"
        exit 1
    fi

    if ! grep -q "^${username}:" "$HTPASSWD_FILE" 2>/dev/null; then
        log_error "L'utilisateur '$username' n'existe pas"
        exit 1
    fi

    # Demander le nouveau mot de passe
    echo -n "Nouveau mot de passe pour $username: "
    read -rs password
    echo
    echo -n "Confirmer le mot de passe: "
    read -rs password_confirm
    echo

    if [ "$password" != "$password_confirm" ]; then
        log_error "Les mots de passe ne correspondent pas"
        exit 1
    fi

    if [ -z "$password" ]; then
        log_error "Le mot de passe ne peut pas être vide"
        exit 1
    fi

    # Générer le hash bcrypt
    local hash
    hash=$(caddy hash-password --plaintext "$password" 2>/dev/null)

    # Mettre à jour le fichier htpasswd
    sed -i "s|^${username}:.*|${username}:${hash}|" "$HTPASSWD_FILE"

    log_info "Mot de passe de '$username' mis à jour"
    apply_changes
}

# Lister les utilisateurs
cmd_list_users() {
    if [ ! -f "$HTPASSWD_FILE" ] || [ ! -s "$HTPASSWD_FILE" ]; then
        log_warn "Aucun utilisateur configuré"
        return
    fi

    echo -e "${BLUE}Utilisateurs configurés:${NC}"
    while IFS=: read -r username _; do
        echo "  - $username"
    done < "$HTPASSWD_FILE"
}

# Activer/désactiver LAN sans auth
cmd_lan_noauth() {
    local mode="$1"
    
    case "$mode" in
        on)
            load_config
            ESSENSYS_LAN_NOAUTH=1
            save_config
            log_info "Mode LAN sans authentification ACTIVÉ"
            log_warn "⚠️  Les appareils sur le réseau local peuvent accéder sans mot de passe"
            apply_changes
            ;;
        off)
            load_config
            ESSENSYS_LAN_NOAUTH=0
            save_config
            log_info "Mode LAN sans authentification DÉSACTIVÉ"
            log_info "Authentification requise partout"
            apply_changes
            ;;
        *)
            log_error "Usage: essensys-auth lan-noauth on|off"
            exit 1
            ;;
    esac
}

# Activer/désactiver l'authentification
cmd_auth() {
    local mode="$1"
    
    case "$mode" in
        on)
            load_config
            ESSENSYS_AUTH_ENABLED=1
            save_config
            log_info "Authentification ACTIVÉE"
            apply_changes
            ;;
        off)
            load_config
            ESSENSYS_AUTH_ENABLED=0
            save_config
            log_warn "⚠️  Authentification DÉSACTIVÉE - Accès libre à tous!"
            apply_changes
            ;;
        *)
            log_error "Usage: essensys-auth auth on|off"
            exit 1
            ;;
    esac
}

# Afficher le statut
cmd_status() {
    load_config
    
    echo -e "${BLUE}╔══════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║     Statut Authentification Essensys     ║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════╝${NC}"
    echo
    
    # Statut Auth
    if [ "$ESSENSYS_AUTH_ENABLED" = "1" ]; then
        echo -e "  Auth:          ${GREEN}✓ Activée${NC}"
    else
        echo -e "  Auth:          ${RED}✗ Désactivée${NC}"
    fi
    
    # Statut LAN
    if [ "$ESSENSYS_LAN_NOAUTH" = "1" ]; then
        echo -e "  LAN sans auth: ${YELLOW}✓ Activé${NC} (réseaux privés sans mdp)"
    else
        echo -e "  LAN sans auth: ${GREEN}✗ Désactivé${NC} (auth partout)"
    fi
    
    echo -e "  Realm:         $ESSENSYS_AUTH_REALM"
    echo
    
    # Utilisateurs
    local user_count=0
    if [ -f "$HTPASSWD_FILE" ] && [ -s "$HTPASSWD_FILE" ]; then
        user_count=$(wc -l < "$HTPASSWD_FILE")
    fi
    echo -e "  Utilisateurs:  $user_count"
    
    # Caddy status
    echo
    if systemctl is-active --quiet caddy; then
        echo -e "  Caddy:         ${GREEN}● Actif${NC}"
    else
        echo -e "  Caddy:         ${RED}● Inactif${NC}"
    fi
    
    echo
    echo -e "${BLUE}Fichiers:${NC}"
    echo "  Config:   $CONFIG_FILE"
    echo "  Htpasswd: $HTPASSWD_FILE"
    echo "  Caddy:    $CADDY_CONFIG"
}

# Aide
show_help() {
    cat <<EOF
${BLUE}essensys-auth${NC} - Gestion de l'authentification Essensys

${YELLOW}Usage:${NC}
  essensys-auth <commande> [arguments]

${YELLOW}Commandes utilisateurs:${NC}
  add-user <user>    Ajouter un utilisateur
  del-user <user>    Supprimer un utilisateur
  passwd <user>      Changer le mot de passe d'un utilisateur
  list-users         Lister les utilisateurs

${YELLOW}Commandes authentification:${NC}
  auth on|off        Activer/désactiver l'authentification globale
  lan-noauth on|off  Activer/désactiver l'accès LAN sans auth
  status             Afficher le statut actuel

${YELLOW}Options:${NC}
  -h, --help         Afficher cette aide

${YELLOW}Exemples:${NC}
  essensys-auth add-user admin
  essensys-auth lan-noauth on
  essensys-auth status

${YELLOW}Notes de sécurité:${NC}
  - WAN: authentification TOUJOURS obligatoire si auth=on
  - LAN: authentification optionnelle avec lan-noauth
  - Les mots de passe sont hashés avec bcrypt (Caddy)

EOF
}

# Main
main() {
    check_root
    init_config

    case "${1:-}" in
        add-user)
            cmd_add_user "$2"
            ;;
        del-user)
            cmd_del_user "$2"
            ;;
        passwd)
            cmd_passwd "$2"
            ;;
        list-users)
            cmd_list_users
            ;;
        lan-noauth)
            cmd_lan_noauth "$2"
            ;;
        auth)
            cmd_auth "$2"
            ;;
        status)
            cmd_status
            ;;
        -h|--help|help)
            show_help
            ;;
        *)
            show_help
            exit 1
            ;;
    esac
}

main "$@"
