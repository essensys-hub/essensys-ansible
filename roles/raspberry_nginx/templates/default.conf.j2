# Configuration principale: Frontend sur / et API sur /api/ (port 80)
# IMPORTANT: Nginx gere le frontend local ET les API locales
# Traefik gere uniquement le frontend WAN (port 443)

{% if gateway_dual_nic | default(false) %}
# Profil gateway : rejeter les requetes HTTP arrivant sur eth0 (LAN)
# Seul le segment armoire (eth1) doit pouvoir joindre ce Nginx en HTTP
server {
    listen {{ gateway_eth0_ip | default(ansible_default_ipv4.address, true) }}:80;
    server_name _;
    return 444;
}
{% endif %}

server {
{% if gateway_dual_nic | default(false) %}
    # Profil gateway : ecouter uniquement sur eth1 (segment armoire)
    # Compatibilite client legacy BP_MQX_ETH - port 80, single-packet TCP
    listen {{ gateway_eth1_ip }}:80 default_server;
{% else %}
    listen 80 default_server;
{% endif %}
    server_name _;

    # Bloquer l'acces HTTP depuis Internet (autoriser LAN/localhost)
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    # Desactiver toute redirection automatique
    port_in_redirect off;

    root /var/www/html;
    index index.html index.htm;

    # Charset
    charset utf-8;

    # Logs
    access_log /var/log/nginx/essensys-access.log;
    error_log /var/log/nginx/essensys-error.log warn;

    # Gzip compression (sauf API)
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json application/javascript;

    # Cache pour les assets statiques
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Servir les fichiers HTML directement
    location ~* \.html$ {
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
    }

    # Proxy pour les API vers le backend
    # CRITIQUE: Configuration compatible avec client legacy BP_MQX_ETH
    # Le client necessite des reponses en un seul paquet TCP
    location /api/ {
        client_body_buffer_size 64k;
        client_max_body_size 64k;

        proxy_pass http://127.0.0.1:{{ backend_port }}/api/;
        proxy_http_version 1.1;

        # Headers de requete
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CRITIQUE: Bufferiser la reponse complete pour single-packet TCP
        # Le client legacy ne peut pas gerer les reponses fragmentees
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_busy_buffers_size 8k;
        proxy_max_temp_file_size 0;

        # Desactiver gzip pour les API (evite la fragmentation)
        gzip off;

        # Preserver les headers originaux du backend
        proxy_pass_header Content-Type;
        proxy_pass_header Content-Length;
        proxy_pass_header Connection;

        # Ne pas modifier les headers de reponse
        proxy_hide_header X-Powered-By;
        proxy_hide_header Server;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Fermer la connexion apres la reponse (compatible avec Connection: close)
        proxy_set_header Connection "close";

        proxy_intercept_errors on;
    }

    # Health check endpoint
    location /health {
        proxy_pass http://127.0.0.1:{{ backend_port }}/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # Debug Interface
    location /debug {
        proxy_pass http://127.0.0.1:{{ backend_port }}/debug;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # Reference Table (Redis Dump)
    location /table_ref {
        proxy_pass http://127.0.0.1:{{ backend_port }}/table_ref;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        access_log off;
    }

    # Proxy MCP
    location /mcp/ {
        proxy_pass http://127.0.0.1:{{ mcp_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Proxy Control Plane
    location /controle_plane/ {
        proxy_pass http://127.0.0.1:{{ control_plane_port }}/controle_plane/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }

    # Proxy Prometheus
    location /prometheus/ {
        proxy_pass http://127.0.0.1:{{ prometheus_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }

    # Proxy Alertmanager
    location /alertmanager/ {
        proxy_pass http://127.0.0.1:{{ alertmanager_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_http_version 1.1;
    }

    # Proxy OpenClaw UI
    location /openclaw/ {
        proxy_pass http://127.0.0.1:{{ openclaw_port }}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;

        # Permettre l'intégration en iframe en masquant les en-têtes restrictifs d'OpenClaw
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Content-Security-Policy;
    }

    # Servir le frontend (SPA) directement sur / - PAS DE REDIRECTION
    location / {
        absolute_redirect off;
        port_in_redirect off;
        try_files $uri $uri/ /index.html;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Securite - bloquer l'acces aux fichiers caches
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    location = /robots.txt {
        log_not_found off;
        access_log off;
    }
}

# Dashboard Traefik (traefik.essensys.fr)
server {
{% if gateway_dual_nic | default(false) %}
    listen {{ gateway_eth1_ip }}:80;
{% else %}
    listen 80;
{% endif %}
    server_name traefik.essensys.fr;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
