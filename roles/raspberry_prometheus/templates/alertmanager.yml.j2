global:
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'severity']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: default

  routes:
    - match:
        severity: critical
      receiver: critical
      group_wait: 10s
      repeat_interval: 1h

receivers:
  - name: default
    webhook_configs:
      - url: 'http://127.0.0.1:{{ openclaw_port }}/hooks/agent'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ openclaw_hooks_token }}'

  - name: critical
    webhook_configs:
      - url: 'http://127.0.0.1:{{ openclaw_port }}/hooks/agent'
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: '{{ openclaw_hooks_token }}'

inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: ['alertname']
