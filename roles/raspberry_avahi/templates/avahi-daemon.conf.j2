# Gere par Ansible - role raspberry_avahi
[server]
domain-name={{ avahi_domain }}
{% if gateway_dual_nic | default(false) %}
allow-interfaces=eth0
deny-interfaces=eth1
{% endif %}
use-ipv4=yes
use-ipv6={{ 'yes' if avahi_use_ipv6 else 'no' }}
ratelimit-interval-usec=1000000
ratelimit-burst=1000

[wide-area]
enable-wide-area=no

[publish]
publish-addresses=yes
publish-hinfo=no
publish-workstation=no
publish-domain=yes
add-service-cookie=no
publish-resolv-conf-dns-servers=no
publish-aaaa-on-ipv4=no
publish-a-on-ipv6=no

[reflector]
enable-reflector=no

[rlimits]
rlimit-core=0
rlimit-data=4194304
rlimit-fsize=0
rlimit-nofile=768
rlimit-stack=4194304
rlimit-nproc=3
