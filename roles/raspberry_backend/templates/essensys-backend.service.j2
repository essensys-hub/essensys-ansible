[Unit]
Description=Essensys Backend Server
After=network.target

[Service]
Type=simple
User={{ service_user }}
Group={{ service_user }}
WorkingDirectory={{ backend_dir }}
ExecStart={{ backend_dir }}/server -config {{ backend_config }}
Restart=always
RestartSec=5
StandardOutput=append:/var/log/essensys/backend.log
StandardError=append:/var/log/essensys/backend.log

# Environment variables
Environment="LOG_LEVEL=info"
Environment="AUTH_ENABLED=false"

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths={{ install_dir }} /var/log/essensys

[Install]
WantedBy=multi-user.target
