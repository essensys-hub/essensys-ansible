
# Notifications push de la sonnette (sonnette-plages-push-2026-11-008).
# Fournisseur absent = variables non posees (le cloud le desactive).
{% if fcm_project_id | default('') | length > 0 %}
FCM_PROJECT_ID={{ fcm_project_id }}
{% endif %}
{# sops_load convertit un JSON en dictionnaire : le re-serialiser en JSON valide. #}
{% set _fcm = fcm_service_account_json | default('') %}
{% if _fcm is not string %}{% set _fcm = _fcm | to_json %}{% endif %}
{% if _fcm | length > 0 %}
FCM_SERVICE_ACCOUNT_JSON='{{ _fcm | trim }}'
{% endif %}
{% if apns_key_p8 | default('') | length > 0 %}
APNS_KEY_P8='{{ apns_key_p8 | trim }}'
{% endif %}
{% if apns_key_id | default('') | length > 0 %}
APNS_KEY_ID={{ apns_key_id }}
{% endif %}
{% if apns_team_id | default('') | length > 0 %}
APNS_TEAM_ID={{ apns_team_id }}
{% endif %}
{% if apns_bundle_id | default('') | length > 0 %}
APNS_BUNDLE_ID={{ apns_bundle_id }}
{% endif %}
{% if apns_env | default('') | length > 0 %}
APNS_ENV={{ apns_env }}
{% endif %}
