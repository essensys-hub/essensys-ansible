DB_HOST={{ cloud_db_host | default('127.0.0.1') }}
DB_PORT={{ cloud_db_port | default('5432') }}
DB_USER={{ cloud_db_user | default(portal_db_user | default('essensys')) }}
DB_PASSWORD={{ portal_db_password | default('essensys_secure_password') }}
DB_NAME={{ cloud_db_name | default(portal_db_name | default('essensys_db')) }}

PORT={{ cloud_backend_port | default(8080) }}
CONSOLIDATED_MODE=true
MIGRATIONS_DIR={{ cloud_backend_src_dir }}/migrations
CORS_ORIGIN={{ cloud_hub_public_url | default('https://mon.essensys.fr') }}
EXCHANGE_STALE_TTL_SECONDS={{ exchange_stale_ttl_seconds | default(120) }}

JWT_SECRET={{ portal_jwt_secret | default('changeme_random_secret') }}
ADMIN_TOKEN={{ vault_admin_token | default('essensys-admin-secret') }}
ADMIN_EMAILS={{ vault_admin_emails | default('') }}
FRONTEND_URL={{ cloud_frontend_url | default(cloud_hub_public_url ~ '/') }}

# OAuth Google
GOOGLE_CLIENT_ID={{ vault_google_client_id | default('') }}
GOOGLE_CLIENT_SECRET={{ vault_google_client_secret | default('') }}
GOOGLE_REDIRECT_URL={{ vault_google_redirect_url | default(cloud_hub_public_url ~ '/api/auth/google/callback') }}

# OAuth Apple
APPLE_TEAM_ID={{ vault_apple_team_id | default('') }}
APPLE_CLIENT_ID={{ vault_apple_client_id | default('') }}
APPLE_KEY_ID={{ vault_apple_key_id | default('') }}
APPLE_KEY_FILE={{ vault_apple_key_file | default('') }}
APPLE_REDIRECT_URL={{ vault_apple_redirect_url | default(cloud_hub_public_url ~ '/api/auth/apple/callback') }}

# Newsletter SMTP
SMTP_HOST={{ vault_smtp_host | default('') }}
SMTP_PORT={{ vault_smtp_port | default('465') }}
SMTP_USER={{ vault_smtp_user | default('') }}
SMTP_PASS={{ vault_smtp_pass | default('') }}
SMTP_FROM={{ vault_smtp_from | default('') }}

# New Relic APM
NEW_RELIC_ENABLED={{ newrelic_backend_enabled | default(false) | bool | lower }}
NEW_RELIC_APP_NAME={{ newrelic_backend_app_name | default('essensys-cloud-backend') }}
NEW_RELIC_DISTRIBUTED_TRACING_ENABLED=true
{% if newrelic_backend_enabled | default(false) | bool %}
NEW_RELIC_LICENSE_KEY={{ vault_newrelic_license_key }}
{% else %}
NEW_RELIC_LICENSE_KEY=
{% endif %}
