name: essensys

services:
  essensys-mosquitto:
    image: {{ mosquitto_image }}:{{ mosquitto_version }}
    container_name: {{ mosquitto_container_name }}
    network_mode: host
    restart: unless-stopped
    user: "0:0"
    volumes:
      - {{ mosquitto_config_dir }}/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
      - {{ mosquitto_config_dir }}/passwd:/mosquitto/config/passwd:ro
      - {{ mosquitto_data_dir }}:/mosquitto/data
      - {{ mosquitto_log_dir }}:/mosquitto/log

  essensys-redis:
    image: {{ redis_image }}:{{ redis_version }}
    container_name: {{ redis_container_name }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - {{ redis_data_dir }}:/data
      - {{ redis_config_dir }}/redis.conf:/etc/redis/redis.conf:ro

  essensys-backend:
    image: {{ backend_image }}:{{ backend_version }}
    container_name: {{ backend_container_name }}
    network_mode: host
    restart: unless-stopped
    working_dir: /etc/essensys
    entrypoint: ["server"]
    volumes:
      - {{ backend_config }}:/etc/essensys/config.yaml:ro
    depends_on:
      - essensys-redis

  essensys-mcp:
    image: {{ mcp_image }}:{{ mcp_version }}
    container_name: {{ mcp_container_name }}
    network_mode: host
    restart: unless-stopped
    entrypoint: ["mcp-server"]
    command: ["-mode", "sse", "-port", "{{ mcp_port }}", "-token", "{{ mcp_token }}"]
    depends_on:
      - essensys-redis

  essensys-nginx:
    image: {{ nginx_image }}:{{ nginx_version }}
    container_name: {{ nginx_container_name }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - {{ nginx_config_dir }}/default.conf:/etc/nginx/http.d/default.conf:ro
      - {{ nginx_frontend_dir }}:/var/www/html:ro
    depends_on:
      - essensys-backend

  essensys-traefik:
    image: {{ traefik_image }}:{{ traefik_version_docker }}
    container_name: {{ traefik_container_name }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - {{ traefik_config_dir }}:/etc/traefik
      - {{ traefik_log_dir }}:/var/log/traefik

  essensys-control-plane:
    image: {{ control_plane_image }}:{{ control_plane_version }}
    container_name: {{ control_plane_name }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ control_plane_data }}:/data
      - {{ control_plane_config }}:/etc/controlplane/config.yaml:ro
      - {{ data_dir }}:/opt/data:ro

  # --- DNS & Ad Blocking ---

  essensys-adguard:
    image: {{ adguard_image }}:{{ adguard_version }}
    container_name: {{ adguard_container_name }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - {{ adguard_config_dir }}:/opt/adguardhome/conf
      - {{ adguard_data_dir }}:/opt/adguardhome/work

  # --- Monitoring Stack ---

  essensys-prometheus:
    image: {{ prometheus_image }}:{{ prometheus_version }}
    container_name: {{ prometheus_container_name }}
    network_mode: host
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      - --web.listen-address=:{{ prometheus_port }}
      - --web.enable-lifecycle
    volumes:
      - {{ prometheus_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ prometheus_config_dir }}/rules:/etc/prometheus/rules:ro
      - {{ prometheus_data_dir }}:/prometheus

  essensys-alertmanager:
    image: {{ alertmanager_image }}:{{ alertmanager_version }}
    container_name: {{ alertmanager_container_name }}
    network_mode: host
    restart: unless-stopped
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --web.listen-address=:{{ alertmanager_port }}
      - --storage.path=/alertmanager
    volumes:
      - {{ prometheus_config_dir }}/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro

  essensys-node-exporter:
    image: {{ node_exporter_image }}:{{ node_exporter_version }}
    container_name: {{ node_exporter_container_name }}
    network_mode: host
    restart: unless-stopped
    pid: host
    command:
      - --web.listen-address=:{{ node_exporter_port }}
      - --path.rootfs=/host
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)
    volumes:
      - /:/host:ro,rslave

  # --- AI Assistant (OpenClaw) ---

  essensys-openclaw:
    image: {{ openclaw_image }}:{{ openclaw_version }}
    container_name: {{ openclaw_container_name }}
    network_mode: host
    restart: unless-stopped
    env_file:
      - {{ openclaw_config_dir }}/.env
    environment:
      - OPENCLAW_HOME=/data/.openclaw
    volumes:
      - {{ openclaw_data_dir }}:/data
    depends_on:
      - essensys-mcp
