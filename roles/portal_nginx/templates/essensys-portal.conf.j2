# Legacy dual-backend: portal SPA + split API routes (:8081 portal/gateway)

location ^~ /portal/ {
    alias /opt/essensys/portal-frontend/dist/;
    try_files $uri $uri/ /portal/index.html;
}

location /api/portal/ {
    proxy_pass http://127.0.0.1:{{ portal_backend_port | default(8081) }}/api/portal/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location /api/gateway/ {
    proxy_pass http://127.0.0.1:{{ portal_backend_port | default(8081) }}/api/gateway/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
