api:
  dashboard: true
  insecure: true

metrics:
  prometheus:
    addEntryPointsLabels: true
    addServicesLabels: true
    addRoutersLabels: true

entryPoints:
  traefik:
    address: ":8081"
  dashboard:
    address: ":8080"
  websecure:
{% if gateway_dual_nic | default(false) %}
    # Profil gateway : restreindre HTTPS au LAN (eth0) uniquement
    address: "{{ gateway_eth0_ip | default(ansible_default_ipv4.address, true) }}:443"
{% else %}
    address: ":443"
{% endif %}
    http:
      tls:
        certResolver: letsencrypt

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ acme_email }}
      storage: /etc/traefik/acme.json
{% if use_staging %}
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      tlsChallenge: {}

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

log:
  level: INFO
  filePath: /var/log/traefik/traefik.log

accessLog:
  filePath: /var/log/traefik/access.log
  format: json

global:
  checkNewVersion: false
  sendAnonymousUsage: false
