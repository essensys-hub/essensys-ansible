http:
  middlewares:
    redirect-to-https:
      redirectScheme:
        scheme: https
        permanent: true
    auth-wan:
      basicAuth:
        usersFile: /etc/traefik/users.htpasswd

  routers:
    # --- Frontend WAN ---
    frontend-wan:
      rule: "Host(`{{ wan_domain }}`) && !PathPrefix(`/api/`)"
      entryPoints:
        - websecure
      service: frontend-service
      middlewares:
        - auth-wan
      tls:
        certResolver: letsencrypt
      priority: 10

    api-inject-wan:
      rule: "Host(`{{ wan_domain }}`) && PathPrefix(`/api/admin/inject`)"
      entryPoints:
        - websecure
      service: backend-service
      middlewares:
        - auth-wan
      tls:
        certResolver: letsencrypt
      priority: 25

    block-api-wan:
      rule: "Host(`{{ wan_domain }}`) && PathPrefix(`/api/`) && !PathPrefix(`/api/admin/inject`)"
      entryPoints:
        - websecure
      service: block-service
      tls:
        certResolver: letsencrypt
      priority: 15

    # --- Control Plane WAN ---
    control-plane-wan:
      rule: "Host(`{{ wan_domain }}`) && PathPrefix(`/controle_plane`)"
      entryPoints:
        - websecure
      service: control-plane-service
      middlewares:
        - auth-wan
      tls:
        certResolver: letsencrypt
      priority: 20

{% if gateway_dual_nic | default(false) %}
    # --- Acces LAN local via mDNS (mon.essensys.local) ---
    frontend-local:
      rule: "Host(`{{ avahi_hostname }}.{{ avahi_domain }}`)"
      entryPoints:
        - websecure
      service: frontend-service
      tls: {}
      priority: 5

    api-local:
      rule: "Host(`{{ avahi_hostname }}.{{ avahi_domain }}`) && PathPrefix(`/api/`)"
      entryPoints:
        - websecure
      service: backend-service
      tls: {}
      priority: 8

    control-plane-local:
      rule: "Host(`{{ avahi_hostname }}.{{ avahi_domain }}`) && PathPrefix(`/controle_plane`)"
      entryPoints:
        - websecure
      service: control-plane-service
      tls: {}
      priority: 8
{% endif %}

  services:
    frontend-service:
      loadBalancer:
        servers:
{% if gateway_dual_nic | default(false) %}
          - url: "http://{{ gateway_eth1_ip }}:80"
{% else %}
          - url: "http://127.0.0.1:80"
{% endif %}
        passHostHeader: true

    backend-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:7070"
        passHostHeader: true

    block-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:8082"
        passHostHeader: true

    control-plane-service:
      loadBalancer:
        servers:
          - url: "http://127.0.0.1:{{ control_plane_port }}"
        passHostHeader: true
