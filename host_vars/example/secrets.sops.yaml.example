# Exemple secrets gateway CM5 (phase 2) — NE PAS committer en clair.
# Copier vers host_vars/<inventory_hostname>/secrets.sops.yaml puis chiffrer :
#   sops --encrypt --age <pubkey> --in-place host_vars/<hostname>/secrets.sops.yaml

cloud_gateway_id: "gw-example"
cloud_gateway_token: "replace-me"
cloud_gateway_machine_id: 0
cloud_gateway_eth0_mac: "aa:bb:cc:dd:ee:ff"
cloud_gateway_eth1_mac: "11:22:33:44:55:66"
