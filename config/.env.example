# Copier vers config/.env et remplir les valeurs (optionnel — secrets cloud dans SOPS)

# SOPS + age (recommandé — voir docs/secrets.md)
SOPS_AGE_KEY_FILE=

# Legacy Ansible Vault (rollback uniquement)
ANSIBLE_VAULT_PASSWORD=

NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_REGION=EU

VAULT_NEW_RELIC_LICENSE_KEY=
VAULT_NEW_RELIC_BROWSER_LICENSE_KEY=

NEW_RELIC_API_KEY=

NEWRELIC_ENABLED=false
NEWRELIC_BACKEND_ENABLED=false
NEWRELIC_BROWSER_ENABLED=false
NEWRELIC_BACKEND_APP_NAME=essensys-user-portal-backend

NEWRELIC_BROWSER_APPLICATION_ID=
NEWRELIC_BROWSER_AGENT_ID=
NEWRELIC_BROWSER_TRUST_KEY=

NEWRELIC_SUPPORT_BROWSER_ENABLED=false
NEWRELIC_SUPPORT_BROWSER_APPLICATION_ID=
NEWRELIC_SUPPORT_BROWSER_AGENT_ID=
NEWRELIC_SUPPORT_BROWSER_TRUST_KEY=

NEWRELIC_INFRA_DISPLAY_NAME=ovh-mon-essensys

PORTAL_DB_HOST=127.0.0.1
PORTAL_DB_PORT=5432
PORTAL_DB_USER=essensys
PORTAL_DB_NAME=essensys_db
PORTAL_DB_PASSWORD=

# Secrets cloud → secrets/cloud/essensys.sops.yaml (SOPS + age)
# portal_db_password, portal_db_name, portal_jwt_secret
# vault_admin_token, vault_admin_emails, cloud_frontend_url
# vault_smtp_*, vault_google_*, vault_apple_* (vault_apple_key_content optionnel)
# vault_newrelic_license_key, vault_newrelic_browser_license_key, vault_newrelic_api_key
