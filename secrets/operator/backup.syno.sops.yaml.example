syno_host: "192.168.1.61"
syno_user: "nrineau"
syno_share: "BACKUP-ESSENSYS"
syno_pass: "REPLACE_ME"

rclone_remote: "syno-essensys"
backup_remote_base: "essensys"
backup_retention_days: 30

# Monorepo complet à sauvegarder (défaut ESSENSYS)
backup_monorepo_root: "/Users/nrineau/ESSENSYS"
# Fichier exclusions rclone (node_modules, caches…) — vide = tout copier
backup_rclone_exclude_file: "config/backup-rclone-exclude.txt"

# Chemins extra hors monorepo, séparés par : (optionnel)
backup_extra_paths: ""
