# Modèle — chiffrer avec :
#   export SOPS_AGE_KEY_FILE=.age/keys.txt
#   sops --encrypt --age "$(age-keygen -y .age/keys.txt)" --in-place secrets/operator/backup.syno.sops.yaml
# ou copier vers backup.syno.sops.yaml puis : sops secrets/operator/backup.syno.sops.yaml

syno_host: "192.168.1.61"
syno_user: "nrineau"
syno_share: "BACKUP-ESSENSYS"
syno_pass: "REPLACE_ME"

rclone_remote: "syno-essensys"
backup_remote_base: "essensys"
backup_retention_days: 30

# Chemins extra séparés par : (optionnel)
backup_extra_paths: ""
